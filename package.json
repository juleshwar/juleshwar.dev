{
  "name": "starter-blog",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "next dev --webpack",
    "dev": "cross-env INIT_CWD=$PWD next dev --webpack",
    "build": "cross-env NODE_ENV=production INIT_CWD=$PWD contentlayer2 build && cross-env INIT_CWD=$PWD next build --webpack && node ./scripts/postbuild.mjs",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "lint": "eslint --fix pages components layouts scripts"
  },
  "dependencies": {
    "@fontsource/open-sans": "^5.3.0",
    "@next/bundle-analyzer": "16.4.5",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "autoprefixer": "^10.6.2",
    "contentlayer2": "0.5.8",
    "esbuild": "^0.28.1",
    "github-slugger": "^2.0.0",
    "katex": "0.18.2",
    "next": "16.4.5",
    "next-contentlayer2": "0.5.8",
    "next-themes": "^0.4.6",
    "pliny": "0.4.1",
    "postcss": "^8.5.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-citation": "^2.3.2",
    "rehype-katex": "^7.0.1",
    "rehype-preset-minify": "7.0.1",
    "rehype-prism-plus": "^2.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^3.4.19",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globby": "11.0.3",
    "husky": "^8.0.0",
    "lint-staged": "^13.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.9"
  },
  "pnpm": {
    "overrides": {
      "next-themes": "0.4.6",
      "postcss-selector-parser": "^6.1.5",
      "zod": "^4.6.6",
      "toml": "^5.0.1",
      "pliny>js-yaml": "^4.3.2",
      "mdx-bundler>uuid": "^11.1.1",
      "katex": "0.18.2"
    }
  }
}
